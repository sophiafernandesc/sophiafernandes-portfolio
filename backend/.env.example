# Variáveis de ambiente do back-end.
#
# O Spring não lê este arquivo: ele é a referência do que preencher no painel do
# Render. Nada aqui tem valor real.
#
# Para desenvolvimento na máquina, use backend/local.properties: ele usa estes
# mesmos nomes, é carregado automaticamente e o .gitignore o barra.

# Origem autorizada a chamar a API. Em producao, o apex (o www redireciona para ele).
CORS_ORIGIN=https://sophiafernandes.dev

# Caixa que recebe as mensagens do formulário.
CONTATO_DESTINATARIO=sophiaferch@gmail.com

# SMTP. No Gmail, SMTP_SENHA é uma senha de app de 16 caracteres,
# gerada em myaccount.google.com/apppasswords, nunca a senha da conta.
SMTP_HOST=smtp.gmail.com
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=

# reCAPTCHA v2. Ligar em producao. A secret key fica só aqui;
# a site key, pública, vai no .env.local do front-end.
RECAPTCHA_HABILITADO=true
RECAPTCHA_SECRET=
